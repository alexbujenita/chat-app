<header class="navbar navbar-expand-md fixed-top navbar-dark bg-dark">
  <div class="container-nav-bar">
    <img src='<%= image_path('rails.png') %>' 
          class='logo-image'
      >
    <div class="nav-bar-menu">
      <nav>
        <ul class="navbar-nav ms-auto nav-bar-list">
          <li class="nav-item"><%= link_to "Home", root_path, class: "nav-link" %></li>
          
          <% if logged_in? %>
            <li class="nav-item"><%= link_to "Users", users_path, class: "nav-link" %></li>
            <li class="nav-item dropdown">
              <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                Account
              </a>
              <ul class="dropdown-menu" style="background-color: white;">
                <li><%= link_to "Profile", current_user, class: "dropdown-item" %></li>
                <li><%= link_to "Settings", edit_user_path(current_user), class: "dropdown-item" %></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <%= link_to "Log out", logout_path, class: "dropdown-item", data: { turbo_method: :delete } %>
                </li>
              </ul>
            </li>
          <% else %>
            <li class="nav-item"><%= link_to "Log in", login_path, class: "nav-link" %></li>
          <% end %>
          <li class="nav-item"><%= link_to "About", about_path, class: "nav-link" %></li>
        </ul>
      </nav>
    </div>
  </div>
</header>